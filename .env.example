# Django Settings — copy to .env and fill in real values
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# App Links / Universal Links
# Debug SHA-256 = APK debug actuel. Laisser RELEASE et PLAY vides jusqu'aux comptes Play.
ANDROID_APP_PACKAGE=com.daxipro.daxi
ANDROID_APP_SHA256_DEBUG=23:9A:2B:CA:63:B6:5F:AF:68:9E:92:88:47:22:A5:F0:64:E7:81:02:D6:64:FE:A0:2F:62:15:3D:8B:47:0F:A7
ANDROID_APP_SHA256_RELEASE=
ANDROID_APP_SHA256_PLAY=
ANDROID_APP_SHA256_FINGERPRINTS=
IOS_APP_TEAM_ID=YOUR_APPLE_TEAM_ID
IOS_APP_BUNDLE_ID=com.daxipro.daxi

# Production security
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Database — local: SQLite. Railway: ajoute le plugin Postgres (DATABASE_URL auto).
# DATABASE_ENGINE=sqlite
# DATABASE_ENGINE=postgresql
# DATABASE_ENGINE=postgis
# Railway fournit DATABASE_URL → pas besoin de POSTGRES_* manuels.
# DATABASE_URL=postgresql://user:pass@host:5432/daxi
# POSTGRES_DB=daxi
# POSTGRES_USER=daxi
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require

# Sauvegarde auto (copie gzip tous les jours, conservée 14 jours dans /backups)
BACKUP_ENABLED=True
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# Email (SMTP Zoho Mail)
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_HOST_USER=info@daxipro.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DAXI <info@daxipro.com>

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase Web SDK (navigateur — injecté par Django au chargement)
# Firebase Web SDK (même projet Android/iOS: 392925120550)
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_WEB_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=your-project-id
FIREBASE_WEB_MESSAGING_SENDER_ID=000000000000
FIREBASE_WEB_APP_ID=1:000000000000:web:yourappid
# Vide = VAPID défaut Firebase. Optionnel: clé publique Web Push certificates
FIREBASE_WEB_VAPID_KEY=

# Mapbox (optional — 3D maps on client orders)
MAPBOX_ACCESS_TOKEN=

# Groq / DeepSeek / Gemini (chatbot + analyse documents — jamais dans le frontend)
GROQ_API_KEY=your-groq-api-key
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Transak card payments (leave empty until configured)
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_WALLET_ADDRESS=
TRANSAK_ENVIRONMENT=STAGING

# Admin MonCash phone (shown to drivers for cash commission payments)
ADMIN_MONCASH_PHONE=+509XXXXXXXX

# MonCashConnect — MonCash mobile (sk_proj_… depuis tableau de bord MonCashConnect)
MONCASH_CONNECT_SECRET_KEY=
MONCASH_CONNECT_WEBHOOK_SECRET=
MONCASH_CONNECT_BASE_URL=https://hvlmeoqyxaguzcujpmit.supabase.co/functions/v1

# HatexCard — paiement carte HTG (clé serveur uniquement, jamais dans le frontend)
HATEXCARD_API_KEY=
HATEXCARD_WEBHOOK_SECRET=

# WhatsApp Cloud API (inbound webhook auto-reply)
WHATSAPP_VERIFY_TOKEN=change-this-verify-token-in-production
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATE_LANG=fr

# Cloudflare Workers AI (driver car image generation)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudinary (upload images — même variables que outoubon: CLOUDINARY_SECRET accepté aussi)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Redis (required in production for WebSocket scaling)
REDIS_URL=redis://127.0.0.1:6379

# Media & Static
MEDIA_URL=/media/
STATIC_URL=/static/

# Firebase Cloud Messaging (push — app fermée OK via payload notification + HIGH)
# Local: fichier dans secrets/
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
# Railway: coller le JSON complet du service account (une ligne) — prioritaire sur le fichier
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# Driver registration
DRIVER_REGISTRATION_STRICT_DOCS=false
DRIVER_DOC_ALLOW_MANUAL_REVIEW=true

# WhatsApp template names (optional overrides — defaults in julmin_taxis/whatsapp_templates.py)
# WA_TPL_NOUVELLE_COMMANDE=nouvelle_commande
# WA_TPL_PRIX_PROPOSE=prix_propose
# WA_TPL_CHAUFFEUR_ASSIGNE=chauffeur_assigne
# WA_TPL_CHAUFFEUR_EN_ROUTE=chauffeur_en_route
# WA_TPL_CHAUFFEUR_ARRIVE=chauffeur_arrive
# WA_TPL_COURSE_DEMARREE=course_demarree
# WA_TPL_COURSE_TERMINEE=course_terminee
# WA_TPL_RECU=recu_course
# WA_TPL_PAUSE=pause_course
# WA_TPL_RAPPEL=rappel_course
# WA_TPL_OTP=demande_numero_badge_de_mon_chauffeur
# WA_TPL_WELCOME_CLIENT=welcome_client
# WA_TPL_CHAUFFEUR_VALIDE=chauffeur_valide
# WA_TPL_COURSE_TERMINER_CHAUFFEUR=course_terminer_chauffeur
# WA_TPL_COMMANDE_ENTREPRISE=commande_entreprise
# WA_TPL_DEMANDE_PAIMENT=demande_paiment
# WA_TPL_SOS_CLIENT=sos_client
# WA_TPL_SOS_ADMIN=sos_admin
# WA_TPL_NOUVELLE_COMMANDE_ADMIN=nouvelle_commande_admin
# WA_TPL_OBJET_OUBLIE_ADMIN=objet_oublie_admin
# WA_TPL_ENTREPRISE_EN_ATTENTE=entreprise_en_attente
# WA_TPL_ENTREPRISE_EMPLACEMENT=entreprise_emplacement
# WA_TPL_CHAT_ESCALADE=chat_escalade
# WA_TPL_CHAUFFEUR_A_VALIDER=chauffeur_a_valider
# WA_TPL_COURSE_DEMARREE=course_demarree
# WA_TPL_COURSE_ANNULEE=course_annulee
# WA_TPL_PRIX_CONFIRME=prix_confirme
