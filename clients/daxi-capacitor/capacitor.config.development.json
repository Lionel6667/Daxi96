{
  "appId": "com.daxipro.daxi",
  "appName": "Daxi",
  "webDir": "www",
  "server": {
    "cleartext": true,
    "androidScheme": "https",
    "iosScheme": "https",
    "hostname": "localhost",
    "allowNavigation": [
      "localhost",
      "localhost:8000",
      "127.0.0.1",
      "127.0.0.1:8000",
      "daxipro.com",
      "*.daxipro.com",
      "*.ngrok-free.dev",
      "*.ngrok-free.app",
      "*.ngrok.io"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#070B14",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": false,
      "splashImmersive": false,
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DEFAULT",
      "overlaysWebView": false
    }
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#070B14",
    "overrideUserAgent": "Mozilla/5.0 (Linux; Android 14; Mobile) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Mobile Safari/537.36 DaxiAndroid/1.6.5 Capacitor"
  },
  "ios": {
    "backgroundColor": "#070B14",
    "contentInset": "automatic",
    "preferredContentMode": "mobile"
  }
}
