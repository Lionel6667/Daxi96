# Copier vers keystore.properties (NE PAS committer keystore.properties)
# IMPORTANT: utiliser des slashs / (pas \) — Java Properties traite \ comme échappement.
#
# Alternatives via variables d'environnement (prioritaires si définies) :
#   DAXI_STORE_FILE
#   DAXI_KEY_ALIAS
#   DAXI_STORE_PASSWORD
#   DAXI_KEY_PASSWORD

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=daxi
storeFile=C:/Users/USER/AppData/Local/daxi-signing/daxi-release.keystore
